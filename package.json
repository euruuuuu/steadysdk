{
  "name": "sdkgen-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/cli"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "sdkgen": "node packages/cli/dist/index.js",
    "examples": "npm run build && node packages/cli/dist/index.js generate --cwd examples/petstore"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pluralize": "^0.0.33",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
